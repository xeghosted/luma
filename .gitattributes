# This repo is developed on Windows but its scripts run under WSL/bash, and
# core.autocrlf=true would otherwise check them out with CRLF. A shell script
# with CRLF does not merely look odd — bash fails on it outright:
#
#   tests/run.sh: line 8: set: -: invalid option
#   tests/run.sh: line 9: cd: $'/mnt/e/...\r': No such file or directory
#
# That is exactly how the test runner broke once this branch was merged, so
# these must always be LF regardless of the checking-out platform.
*.sh text eol=lf

# Everything below is BYTE-DIFFED by tests/run.sh against a fresh run of the
# generator that produced it, and every one of those generators pins its output
# to LF. A CRLF checkout therefore reports a perfectly correct file as stale, on
# every line, and the message sends you off to regenerate something that was
# never wrong.
#
# That is not hypothetical. These rules once named the pre-split paths
# (scripts/natives.lua, editor/lua-defs/natives.def.lua,
# src/rage/invoker/natives.h) and kept naming them after the files moved, so
# they quietly stopped matching anything. The files were then committed with
# CRLF, and a fresh clone of this repository failed its own test suite. The
# patterns below are globbed per game precisely so that adding a third one
# cannot reintroduce that.
#
# tests/run.sh now refuses to run if any file it diffs is not covered here, so
# a path that moves out from under these rules fails loudly instead of silently.
scripts/*/natives.lua                text eol=lf
editor/lua-defs/*/natives.def.lua    text eol=lf
editor/lua-defs/*/runtime.def.lua    text eol=lf
src/game/*/natives.h                 text eol=lf
src/game/*/natives_registry.h        text eol=lf
src/game/*/natives_hash.h            text eol=lf
src/script/embedded_lua.h            text eol=lf
tools/native_registry.json           text eol=lf
tools/rdr2_native_signatures.h       text eol=lf

# The Lua the runtime compiles in, and the scripts the console runs. Not
# byte-diffed, but they are read by luac5.4 under WSL in the same suite and
# there is no reason for them to differ by platform.
*.lua text eol=lf
